{
  "name": "bakame",
  "version": "1.0.1",
  "description": "AI Problem Solving Assistant",
  "main": "bootstrap.js",
  "scripts": {
    "start": "node scripts/start.js",
    "dev": "node scripts/start.js --no-sandbox --disable-gpu",
    "test-speech": "node scripts/test-speech.js",
    "test:skills": "node --test tests/skills.test.js",
    "test:skills-ui": "node scripts/test-skills-ui.js",
    "test:window-position": "node --test tests/window-position.test.js",
    "build": "electron-builder",
    "build:mac": "electron-builder --mac",
    "build:win": "npm run build:service && electron-builder --win nsis portable --x64 --config.electronDist=node_modules/electron/dist && node scripts/build-service-installer.js",
    "build:linux": "electron-builder --linux",
    "build:all": "electron-builder --mac --win --linux",
    "dist": "npm run build",
    "pack": "electron-builder --dir",
    "clean": "rm -rf dist/",
    "rebuild": "npm run clean && npm run build",
    "release": "npm run clean && npm run build:all",
    "postinstall": "electron-builder install-app-deps",
    "test:voice": "node --test tests/voice.test.js",
    "test:voice-ui": "node scripts/test-voice-ui.js",
    "test:whisper-local": "node scripts/test-whisper-local.js",
    "build:service": "node scripts/build-windows-service.js",
    "test:privacy": "node scripts/test-privacy-ui.js",
    "test:lifecycle": "node scripts/test-lifecycle.js",
    "test:startup": "node --test tests/startup.test.js",
    "test:mini-ui": "node scripts/test-mini-ui.js"
  },
  "author": {
    "name": "Serge Benit",
    "url": "https://github.com/Sergeb250"
  },
  "contributors": [
    { "name": "TechyCSR (original OpenCluely author)", "email": "info@techycsr.dev", "url": "https://techycsr.dev" }
  ],
  "customizationCredit": "Customized and enhanced by Serge Benit (@Sergeb250). Original OpenCluely by TechyCSR and contributors.",
  "repository": {
    "type": "git",
    "url": "https://github.com/TechyCSR/OpenCluely"
  },
  "license": "SEE LICENSE IN LICENSE",
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.2.0",
    "@google/genai": "^2.9.0",
    "dotenv": "^16.3.1",
    "markdown": "^0.5.0",
    "marked": "^15.0.12",
    "microsoft-cognitiveservices-speech-sdk": "^1.40.0",
    "node-record-lpcm16": "^1.0.1",
    "prismjs": "^1.30.0",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^4.7.1"
  },
  "devDependencies": {
    "electron": "^29.1.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "local.bakame.desktop",
    "productName": "bakame",
    "copyright": "Customized and enhanced by Serge Benit. Original OpenCluely by TechyCSR and contributors.",
    "extraFiles": [
      { "from": "NOTICE", "to": "NOTICE.txt" },
      { "from": "LICENSE", "to": "LICENSE.txt" }
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "**/*",
      "!dist/**/*",
      "!tests/**/*",
      "!*.md",
      "!.git/**/*",
      "!.env*",
      "!.venv-whisper/**/*",
      "!.whisper-models/**/*",
      "!bin/**/*",
      "!scripts/__pycache__/**/*",
      "!**/*.pyc",
      "!eng.traineddata",
      "!release/**/*",
      "!build/**/*",
      "!windows-service/**/*",
      "!scripts/test-*",
      "!scripts/build-*.js",
      "!scripts/verify-*.js"
    ],
    "asarUnpack": [
      "assests/icons/**/*",
      "prompts/**/*",
      "scripts/whisper_worker.py",
      "scripts/whisper_runtime.py"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "darkModeSupport": true,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "bakame uses the microphone to transcribe your speech locally with Whisper.",
        "NSCameraUsageDescription": "bakame does not record video; this entitlement is only present for media-capture compatibility.",
        "NSScreenCaptureUsageDescription": "bakame captures the screen to read on-screen content for AI assistance."
      }
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "sign": null,
      "extraResources": [
        {
          "from": "build/windows-service/bakame.Service.exe",
          "to": "service/bakame.Service.exe"
        }
      ],
      "executableName": "bakame"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assests/icons/app-icon.png",
      "category": "Utility"
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xauth",
        "libasound2t64",
        "libgbm1",
        "python3 (>= 3.10)",
        "python3-venv",
        "python3-pip"
      ],
      "recommends": [
        "ffmpeg"
      ],
      "fpm": [
        "--after-install=scripts/post-install-deb.sh"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "perMachine": false,
      "include": "scripts/post-install-nsis.nsh",
      "deleteAppDataOnUninstall": false,
      "artifactName": "bakame-Setup-${version}.${ext}"
    },
    "dmg": {
      "title": "bakame Interview Assistant",
      "backgroundColor": "#000000",
      "window": {
        "width": 600,
        "height": 400
      }
    },
    "portable": {
      "artifactName": "bakame-Portable-${version}-${arch}.${ext}"
    },
    "compression": "store"
  }
}
